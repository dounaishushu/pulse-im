+	if err = tx.Commit(f.ctx); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err = <-joined:
+		if !errors.Is(err, ErrForbidden) {
+			t.Fatalf("join ignored committed block: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("join failed to finish")
+	}
