{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Pulse workspace commands",
  "windows": [
    "main",
    "workspace-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-info",
    "allow-clear-desktop-cache",
    "allow-report-desktop-diagnostic",
    "allow-open-desktop-logs",
    "allow-check-desktop-update",
    "allow-open-desktop-update",
    "allow-desktop-routes",
    "allow-select-desktop-route",
    "allow-probe-desktop-route",
    "allow-recover-desktop-route",
    "allow-desktop-network-settings",
    "allow-set-desktop-network-settings",
    "allow-test-desktop-network-settings",
    "allow-cancel-desktop-network-probe",
    "allow-desktop-network-exit",
    "allow-list-workspace-groups",
    "allow-import-legacy-workspace-groups",
    "allow-open-workspace-group",
    "allow-remove-workspace-group",
    "allow-focus-primary-workspace",
    "allow-sync-tray-accounts",
    "allow-set-archive-session",
    "allow-open-chat-window",
    "allow-close-chat-windows",
    "allow-relay-chat-window-packet",
    "allow-open-archive-history",
    "allow-open-archive-image",
    "allow-invalidate-archive",
    "allow-observe-archive-event",
    "allow-api-start",
    "allow-api-execute",
    "allow-api-execute-upload",
    "allow-api-cancel",
    "allow-realtime-connect",
    "allow-realtime-send",
    "allow-realtime-disconnect",
    "allow-download-preferences",
    "allow-choose-download-directory",
    "allow-set-download-prompt",
    "allow-start-download",
    "allow-list-downloads",
    "allow-cancel-download",
    "allow-cancel-account-downloads",
    "allow-open-system-sound-settings",
    "allow-desktop-system-options",
    "allow-set-desktop-system-option",
    "allow-show-desktop-notice",
    "allow-clear-desktop-notices",
    "allow-remembered-signins",
    "allow-read-remembered-signin",
    "allow-remember-signin",
    "allow-forget-remembered-signin",
    "allow-pending-explorer-files",
    "allow-claim-explorer-files",
    "allow-unclaim-explorer-files",
    "allow-discard-explorer-files",
    "allow-prepare-explorer-file",
    "allow-create-upload-stage",
    "allow-push-upload-stage",
    "allow-seal-upload-stage",
    "allow-release-upload-stage",
    "allow-reply-chat-outbox",
    "allow-publish-chat-outbox",
    "allow-begin-screen-capture",
    "allow-take-screen-capture",
    "allow-cancel-screen-capture",
    "allow-copy-conversation-image",
    "allow-chat-typography",
    "allow-set-chat-typography",
    "allow-import-chat-typography"
  ]
}
