  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
