{
  "name": "pulse-web",
  "version": "2.4.198",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:desktop": "vite --host 127.0.0.1 --mode desktop",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop && node ../scripts/verify-web-assets.mjs dist-desktop",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && node ../scripts/verify-web-assets.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "test:accounts": "node tests/accounts.e2e.cjs && node tests/account-edges.e2e.cjs",
    "test:groups": "node tests/group-chat.e2e.cjs",
    "test:broadcast": "node tests/broadcast.e2e.cjs",
    "test:contact-search": "node tests/contact-search.e2e.cjs",
    "test:contact-cards": "node tests/contact-card.e2e.cjs",
    "test:group-mentions": "node tests/group-mentions.e2e.cjs",
    "test:ip-location": "node tests/ip-location.e2e.cjs"
  },
  "dependencies": {
    "@douyinfe/semi-foundation": "2.78.0",
    "@douyinfe/semi-theme-default": "2.78.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "sass": "1.108.2",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
