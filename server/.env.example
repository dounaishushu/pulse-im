# Local development. Use your own PostgreSQL/Redis credentials; no built-in password.
PULSE_POSTGRES_DSN=postgres://pulse:CHANGE_ME@127.0.0.1:5432/pulse?sslmode=disable
PULSE_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
PULSE_LISTEN=127.0.0.1:8080
PULSE_ALLOWED_ORIGINS=http://localhost:5173
# Only list your actual reverse proxy; it must overwrite X-Real-IP.
PULSE_TRUSTED_PROXY_CIDRS=
GOMAXPROCS=4
GOMEMLIMIT=1200MiB

# Private persistent storage. ffprobe is required for video/audio validation.
PULSE_MEDIA_DIR=data/media
PULSE_RUNTIME_DIR=runtime
PULSE_FFPROBE=ffprobe
# Optional provider credentials: paths stay outside the served tree.
PULSE_APNS_KEY_ID=
PULSE_APNS_TEAM=
PULSE_APNS_TOPIC=
PULSE_APNS_KEY_PATH=
PULSE_FCM_ACCOUNT_PATH=
PULSE_TELEGRAM_TOKEN=
# system (default), cloudflare, or google; applies only to api.telegram.org.
PULSE_TELEGRAM_DNS_PROVIDER=system
PULSE_TELEGRAM_WEBHOOK_SECRET=
# Enables one-use, three-minute group PIN authorization for task codes.
PULSE_TELEGRAM_GROUP_PIN=
# Allow group members with the PIN to create accounts and query their own entries.
PULSE_TELEGRAM_GROUP_ACCOUNTS_ENABLED=false
PULSE_ADMIN_BASE_URL=
# GET endpoint accepting ?ip= and returning country, province, city JSON.
PULSE_IP_LOCATION_URL=

# Required to change the administrator IP allowlist; use a unique 32+ character secret.
PULSE_ADMIN_OPS_SECRET=
PULSE_LEGACY_ADMIN_ENTRY_SECRET=
