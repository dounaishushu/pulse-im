# Local development. Use your own PostgreSQL/Redis credentials; no built-in password.
PULSE_POSTGRES_DSN=postgres://pulse:CHANGE_ME@127.0.0.1:5432/pulse?sslmode=disable
PULSE_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
PULSE_LISTEN=127.0.0.1:8080
PULSE_ALLOWED_ORIGINS=http://localhost:5173
# Only list your actual reverse proxy; it must overwrite X-Real-IP.
PULSE_TRUSTED_PROXY_CIDRS=
GOMAXPROCS=4
GOMEMLIMIT=1200MiB
