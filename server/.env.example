# Local development. Use your own PostgreSQL/Redis credentials; no built-in password.
PULSE_POSTGRES_DSN=postgres://pulse:CHANGE_ME@127.0.0.1:5432/pulse?sslmode=disable
PULSE_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
PULSE_LISTEN=127.0.0.1:8080
PULSE_WORKER_ACTIVATION_FILE=
PULSE_ALLOWED_ORIGINS=http://localhost:5173
# Only list your actual reverse proxy; it must overwrite X-Real-IP.
PULSE_TRUSTED_PROXY_CIDRS=
GOMAXPROCS=4
GOMEMLIMIT=1200MiB

# Optional. Defaults suit a small host. See deploy/capacity-large.env for an example.
# Budget DB connections across all app processes and leave room for administration.
# PULSE_DB_MAX_CONNS=16
# PULSE_DB_MIN_CONNS=2
# PULSE_REDIS_POOL_SIZE=8
# PULSE_REDIS_MAX_CONNS=0
# PULSE_HTTP_MAX_INFLIGHT=256
# PULSE_HTTP_MAX_TRANSFERS=128
# PULSE_PUSH_WORKERS=3
# PULSE_PUSH_BATCH_SIZE=96
# PULSE_PUSH_SEND_PARALLELISM=16
# PULSE_WS_MAX_HANDSHAKES=128
# PULSE_WS_MAX_CONNECTIONS=12000
# PULSE_WS_QUEUE_MIB=32
# PULSE_MEDIA_UPLOAD_SLOTS=8
# PULSE_MEDIA_WORKERS=2
# PULSE_MEDIA_WAIT_SLOTS=64
# PULSE_MEDIA_QUEUE_JOBS=1000
# PULSE_MEDIA_QUEUE_GIB=4
# PULSE_MEDIA_DECODE_MIB=512
# PULSE_MEDIA_UPLOAD_SECONDS=120
# PULSE_MEDIA_ADMISSION_MS=100
# PULSE_MEDIA_ADMISSION_PARALLELISM=1

# Private persistent storage. ffprobe is required for video/audio validation.
PULSE_MEDIA_DIR=data/media
PULSE_RUNTIME_DIR=runtime
PULSE_FFPROBE=ffprobe
# Optional provider credentials: paths stay outside the served tree.
PULSE_APNS_KEY_ID=
PULSE_APNS_TEAM=
PULSE_APNS_TOPIC=
PULSE_APNS_KEY_PATH=
PULSE_FCM_ACCOUNT_PATH=
PULSE_TELEGRAM_TOKEN=
# system (default), cloudflare, or google; applies only to api.telegram.org.
PULSE_TELEGRAM_DNS_PROVIDER=system
PULSE_TELEGRAM_WEBHOOK_SECRET=
# Enables one-use, three-minute group PIN authorization for task codes.
PULSE_TELEGRAM_GROUP_PIN=
# Allow group members with the PIN to create accounts and query their own entries.
PULSE_TELEGRAM_GROUP_ACCOUNTS_ENABLED=false
PULSE_ADMIN_BASE_URL=
# Optional custom GET provider (?ip=, flat country/province/city JSON).
PULSE_IP_LOCATION_URL=
# IPPure queries the calling device only. Matching client-reported locations are
# shown to authorized internal staff; no arbitrary-IP lookup or district is inferred.
# Set false to collect only the IM connection address.
PULSE_IPPURE_ENABLED=true

# Required to change the administrator IP allowlist; use a unique 32+ character secret.
PULSE_ADMIN_OPS_SECRET=
PULSE_LEGACY_ADMIN_ENTRY_SECRET=

# Optional encrypted user-password copies, disabled when empty. A base64-encoded
# random 32-byte key; keep it outside source control, served files and DB backups.
# Configure the SAME key on all API/CLI instances before creating/resetting passwords.
# Existing hashes cannot be recovered. Login never captures old passwords.
# Only superadmins can reveal a recorded current password, after password reauthentication.
PULSE_USER_PASSWORD_ENCRYPTION_KEY=
