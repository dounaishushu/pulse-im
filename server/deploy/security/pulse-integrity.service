[Unit]
Description=Verify Pulse published assets and executable

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/pulse-integrity-check.py
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/pulse /etc/pulse
Nice=10
IOSchedulingClass=idle
