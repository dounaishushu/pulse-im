# Capacity profile for the 56 logical CPU, 63 GiB production host.
# PostgreSQL reserves 3 of 100 slots for superusers. Allow 64 for this instance.
PULSE_DB_MAX_CONNS=64
PULSE_DB_MIN_CONNS=8
PULSE_REDIS_POOL_SIZE=32
PULSE_REDIS_MAX_CONNS=64
PULSE_HTTP_MAX_INFLIGHT=1024
PULSE_HTTP_MAX_TRANSFERS=640
PULSE_WS_MAX_HANDSHAKES=384
PULSE_WS_MAX_CONNECTIONS=24000
PULSE_WS_QUEUE_MIB=96
PULSE_PUSH_WORKERS=6
PULSE_PUSH_BATCH_SIZE=192
PULSE_PUSH_SEND_PARALLELISM=32
PULSE_MEDIA_UPLOAD_SLOTS=64
PULSE_MEDIA_WORKERS=24
PULSE_MEDIA_WAIT_SLOTS=256
PULSE_MEDIA_QUEUE_JOBS=4000
PULSE_MEDIA_QUEUE_GIB=16
PULSE_MEDIA_DECODE_MIB=4096
PULSE_MEDIA_UPLOAD_SECONDS=150
PULSE_MEDIA_ADMISSION_MS=1000
PULSE_MEDIA_ADMISSION_PARALLELISM=16
