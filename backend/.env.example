APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGIN=https://im.example.com,https://admin.im.example.com

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pulse_im
DB_USER=pulse_im
DB_PASSWORD=
DB_CHARSET=utf8mb4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REALTIME_DRIVER=database
REALTIME_CHANNEL=pulse-im:messages
WEBSOCKET_WORKERS=1
WEBSOCKET_POLL_INTERVAL_MS=100
DISPATCH_WORKERS=1

MEDIA_SIGNING_KEY=
# Baidu server-side IP location key; enable IP location and allow API server egress IPs.
# Keep this private; never expose it in browser or mobile/PC bundles.
BAIDU_MAP_AK=
# Optional local CA certificate bundle; defaults to PHP's configured CA or the bundled Mozilla roots.
# TLS verification is always enabled. Keep this as a filesystem path, never a URL.
BAIDU_MAP_CA_BUNDLE=
# Separate named admin accounts are initialized with tools/manage-admin.php.
# Push providers are optional during development; production validation requires them.
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENV=production
FILE_DISK=local
FILE_BASE_URL=https://im.example.com/storage

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=900

# Defaults to true when omitted. Set false to disable admin IP checks only; account login and permissions remain required.
ADMIN_IP_CHECK_ENABLED=true
# When enabled, an empty allowlist hides admin pages and APIs with 404.
# Exact IPv4/IPv6 only. Used as bootstrap before the private allowlist file first exists.
ADMIN_IP_ALLOWLIST=
# Trust only the actual reverse-proxy networks. Empty ignores all forwarded IP headers.
ADMIN_TRUSTED_PROXIES=

# Verified multi-route discovery. Keep the signing key outside the web/source root.
# Sign on the management node, or serve an already signed file on discovery mirrors.
ROUTE_CLUSTER_ID=pulse-im-new-install
ROUTE_DEFAULT_API_URL=https://im.example.com/api
ROUTE_MANIFEST_PRIVATE_KEY_FILE=
ROUTE_MANIFEST_FILE=
# Independently hosted HTTPS copies of the signed file, without private keys.
ROUTE_DISCOVERY_URLS=[]
# A standby/isolated node must not accept authenticated traffic.
ROUTE_NODE_ROLE=active
ROUTE_WS_CHECK_HOST=127.0.0.1
ROUTE_WS_CHECK_PORT=8282
# Optional external-HA writer lease; configuring it makes a missing lease fail closed.
ROUTE_WRITER_LEASE_FILE=
# Separate random secret (at least 32 characters) shared only by the hidden control API and bot.
ADMIN_IP_CONTROL_KEY=
ADMIN_IP_CONTROL_WINDOW=120
# Bot is disabled until token, numeric sender IDs, and endpoint are configured.
TELEGRAM_BOT_TOKEN=
; Optional Telegram-only encrypted DNS: system (default), cloudflare, or google.
TELEGRAM_DNS_PROVIDER=system
; Optional co-located worker: local keeps signed control handling inside this process.
TELEGRAM_CONTROL_MODE=http
TELEGRAM_ADMIN_USER_IDS=
# Empty means private chats only. A group ID alone never authorizes its members.
TELEGRAM_ADMIN_CHAT_IDS=
ADMIN_IP_CONTROL_URL=https://admin.im.example.com/ops/admin-ip-allowlist
# Required for the bot's task-code query; optional if using only IP allowlisting.
# 6..128 bytes. Do not use the example password from the screenshot.
TELEGRAM_ADMIN_PIN=
; Enabled by the dedicated-entry installer after the database and owner are ready.
ADMIN_ENTRY_REQUIRED=false
ADMIN_ENTRY_BASE_URL=
TELEGRAM_ADMIN_ACCOUNTS_ENABLED=false
; Optional: allow human group members to query task codes/create accounts after PIN verification.
; Requires the existing account/entrance setup; prompts and results stay in the originating group.
TELEGRAM_GROUP_PIN_ACCESS=false

# Optional ip-api Pro provider credentials; fill only on the new server.
IP_API_KEY=
IP_API_CA_BUNDLE=

# Required for registration. Generate fresh keys using tools/init-deployment-secrets.php.
PASSWORD_VAULT_KEY=
